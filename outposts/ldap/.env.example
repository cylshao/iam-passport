# 复制为 .env 后填写；.env 不要提交到仓库。

# AUTHENTIK_TAG 不用填：make ldap-up 会从 deployments/chart/Chart.yaml 读出版本写到这里，
# 和 authentik server 保持一致

# 生产环境改成内部 Harbor 地址，例如 harbor.company.com/goauthentik/ldap
# AUTHENTIK_LDAP_IMAGE=ghcr.io/goauthentik/ldap

# outpost 访问 authentik 的地址
# 生产：https://auth.company.com
# 本地验证（Docker Desktop）：http://host.docker.internal:9000
AUTHENTIK_HOST=https://auth.company.com

# 只有 authentik 使用自签名证书时才设为 true，生产环境保持 false
AUTHENTIK_INSECURE=false

# 在 authentik 管理后台 Applications → Outposts 里，点这个 outpost 的 View Deployment Info 获取
# 这个 token 等同于高权限凭据，按密钥管理
AUTHENTIK_TOKEN=

# 端口绑定的地址。生产环境填本机的内网 IP，不要填 0.0.0.0，也不要对公网开放
LDAP_BIND_IP=127.0.0.1
